@startuml
skinparam dpi 170
skinparam backgroundColor white
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam roundcorner 8
skinparam maxMessageSize 200
skinparam sequence {
  ArrowColor #2E74B5
  ActorBorderColor #0B2545
  LifeLineBorderColor #B8C4D1
  LifeLineBackgroundColor #F7F9FC
  ParticipantBorderColor #2E74B5
  ParticipantBackgroundColor #E8EEF5
  ParticipantFontColor #0B2545
}
hide footbox

title Request_DetailedList(Bill_Id)

actor "用户" as A
boundary "详单查询界面" as UI
control "BillingController" as C
control "BillingService" as S
database "DetailedListRepository" as R
A -> UI: 按账单号查询详单
UI -> C: Request_DetailedList(Bill_Id)
C -> S: query_details(carId, Bill_Id)
S -> R: query(carId, billId)
R --> S: 详单列表
S --> C: Return(详单字段集合)
C --> UI: 展示详单
@enduml
