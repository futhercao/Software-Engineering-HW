@startuml
skinparam dpi 170
skinparam backgroundColor white
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam roundcorner 8
skinparam maxMessageSize 200
skinparam sequence {
  ArrowColor #2E74B5
  ActorBorderColor #0B2545
  LifeLineBorderColor #B8C4D1
  LifeLineBackgroundColor #F7F9FC
  ParticipantBorderColor #2E74B5
  ParticipantBackgroundColor #E8EEF5
  ParticipantFontColor #0B2545
}
hide footbox

title Cancel_Request(car_id)

actor "用户" as A
boundary "充电申请界面" as UI
control "ChargingRequestController" as C
control "ChargingRequestService" as S
control "ChargingService" as CHG
control "DispatchService" as D
entity "ChargingPile" as P
A -> UI: 取消充电
UI -> C: Cancel_Request(car_id)
C -> S: cancel_request(payload)
alt 正在充电
  S -> CHG: end_charging(request, reason=取消)
  CHG --> S: 生成详单
else 等候区 / 充电区排队
  S -> P: queue.remove(request)  (若在桩队列)
  S -> S: state = CANCELLED
  S -> D: dispatch_waiting(mode)
end
C --> UI: Return(0/1)
@enduml
