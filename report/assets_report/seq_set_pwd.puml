@startuml
skinparam dpi 170
skinparam backgroundColor white
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam roundcorner 8
skinparam maxMessageSize 200
skinparam sequence {
  ArrowColor #2E74B5
  ActorBorderColor #0B2545
  LifeLineBorderColor #B8C4D1
  LifeLineBackgroundColor #F7F9FC
  ParticipantBorderColor #2E74B5
  ParticipantBackgroundColor #E8EEF5
  ParticipantFontColor #0B2545
}
hide footbox

title set_pwd(******)

actor "用户" as A
boundary "注册/登录界面" as UI
control "AccountController" as C
control "AccountService" as S
entity "UserAccount" as ACC
database "AccountRepository" as R
A -> UI: 输入口令
UI -> C: set_pwd(car_Id, password)
C -> S: set_password(payload)
S -> R: get(car_Id)
R --> S: account
alt 已有凭据
  S -> ACC: verify(password)
  ACC --> S: true / false
else 首次设置
  S -> ACC: set_password(password)
end
S -> ACC: active = true
S --> C: Return(1)
C --> UI: Return(0/1)
@enduml
