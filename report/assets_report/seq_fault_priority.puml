@startuml
skinparam dpi 170
skinparam backgroundColor white
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam roundcorner 8
skinparam maxMessageSize 200
skinparam sequence {
  ArrowColor #2E74B5
  ActorBorderColor #0B2545
  LifeLineBorderColor #B8C4D1
  LifeLineBackgroundColor #F7F9FC
  ParticipantBorderColor #2E74B5
  ParticipantBackgroundColor #E8EEF5
  ParticipantFontColor #0B2545
}
hide footbox

title handlePileFault(pile_Id, PRIORITY) — 优先级调度

actor "管理员" as A
boundary "故障处理界面" as UI
control "FaultDispatchController" as C
control "FaultRecoveryService" as F
control "ChargingService" as CHG
control "PriorityFaultStrategy" as PS
control "DispatchService" as D
entity "ChargingPile" as P
A -> UI: 标记故障并选择优先级调度
UI -> C: handlePileFault(pile_Id, PRIORITY)
C -> F: handle_pile_fault(payload)
F -> P: state = FAULT
alt 故障桩正在充电
  F -> CHG: end_charging(active, 停止计费, skip_dispatch)
  CHG --> F: 生成一条详单
end
F -> P: 故障队列车辆退回等候态(priority)
F -> PS: redispatch(pile, stranded, DispatchService)
PS -> D: 按排队号将故障队列优先分配到同类型其它桩空位
note over D: 暂停等候区叫号，待故障队列调度完毕再恢复
F -> D: dispatch_waiting(mode) 恢复等候区叫号
F --> C: Return(1)
C --> UI: Return(0/1)
@enduml
