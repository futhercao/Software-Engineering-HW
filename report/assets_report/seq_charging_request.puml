@startuml
skinparam dpi 170
skinparam backgroundColor white
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam roundcorner 8
skinparam maxMessageSize 200
skinparam sequence {
  ArrowColor #2E74B5
  ActorBorderColor #0B2545
  LifeLineBorderColor #B8C4D1
  LifeLineBackgroundColor #F7F9FC
  ParticipantBorderColor #2E74B5
  ParticipantBackgroundColor #E8EEF5
  ParticipantFontColor #0B2545
}
hide footbox

title E_chargingRequest(car_Id, Request_Amount, Request_Mode)

actor "用户" as A
boundary "充电申请界面" as UI
control "ChargingRequestController" as C
control "ChargingRequestService" as S
control "AccountService" as AS
control "QueueService" as Q
control "DispatchService" as D
entity "ChargingRequest" as REQ
database "RequestRepository" as R
A -> UI: 选择模式与充电量并提交
UI -> C: E_chargingRequest(car_Id, Amount, Mode)
C -> S: submit_request(payload)
S -> AS: require_account(car_Id)
AS --> S: account
S -> S: 校验电量/模式/无在途请求/等候区容量
S -> Q: make_ticket(Mode)
Q --> S: ticket (F/T 序号)
create REQ
S -> REQ: <<create>> ChargingRequest(car_Id, Amount, Mode, ticket)
S -> R: add(request)
S -> D: dispatch_waiting(Mode)
D -> D: best_pile() 按完成时长最短选桩并入队
S -> Q: count_before(request)
Q --> S: 前车数量
S --> C: Return(car_position, car_state, queue_Num, request_time)
C --> UI: 返回排队信息
UI --> A: 显示排队号/位置/状态
@enduml
