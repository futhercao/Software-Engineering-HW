@startuml
skinparam dpi 170
skinparam backgroundColor white
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam roundcorner 8
skinparam maxMessageSize 200
skinparam sequence {
  ArrowColor #2E74B5
  ActorBorderColor #0B2545
  LifeLineBorderColor #B8C4D1
  LifeLineBackgroundColor #F7F9FC
  ParticipantBorderColor #2E74B5
  ParticipantBackgroundColor #E8EEF5
  ParticipantFontColor #0B2545
}
hide footbox

title Request_Bill(carId, date)

actor "用户" as A
boundary "账单查询界面" as UI
control "BillingController" as C
control "BillingService" as S
database "BillRepository" as R
database "DetailedListRepository" as D
A -> UI: 输入车辆/日期查询账单
UI -> C: Request_Bill(carId, date)
C -> S: query_bill(carId, date)
S -> R: query(carId, date)
R --> S: 账单列表（按日汇总）
loop 每张账单
  S -> D: query(carId, billId)
  D --> S: 该账单下的详单行项
end
S -> S: 汇总 total
S --> C: Return(账单字段 + 明细行 + 汇总)
C --> UI: 展示账单与明细
@enduml
