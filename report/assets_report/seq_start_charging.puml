@startuml
skinparam dpi 170
skinparam backgroundColor white
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam roundcorner 8
skinparam maxMessageSize 200
skinparam sequence {
  ArrowColor #2E74B5
  ActorBorderColor #0B2545
  LifeLineBorderColor #B8C4D1
  LifeLineBackgroundColor #F7F9FC
  ParticipantBorderColor #2E74B5
  ParticipantBackgroundColor #E8EEF5
  ParticipantFontColor #0B2545
}
hide footbox

title Start_Charging(car_id, ChargePileNum)

actor "用户" as A
boundary "充电控制界面" as UI
control "ChargingRequestController" as C
control "ChargingRequestService" as RS
control "ChargingService" as S
entity "ChargingPile" as P
entity "ChargeSession" as SE
A -> UI: 队首车辆开始充电
UI -> C: Start_Charging(car_id, ChargePileNum)
C -> RS: start_charging(payload)
RS -> S: start_charging(request, pile)
S -> P: 校验队首 且 无在充车辆
S -> P: queue.pop(0)
create SE
S -> SE: <<create>> ChargeSession(pileId, start, duration)
S -> P: activeRequestId = request.id
S --> RS: Return(1)
RS --> C: Return(1)
C --> UI: Return(0/1)
@enduml
