@startuml
skinparam dpi 170
skinparam backgroundColor white
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam roundcorner 8
skinparam maxMessageSize 200
skinparam sequence {
  ArrowColor #2E74B5
  ActorBorderColor #0B2545
  LifeLineBorderColor #B8C4D1
  LifeLineBackgroundColor #F7F9FC
  ParticipantBorderColor #2E74B5
  ParticipantBackgroundColor #E8EEF5
  ParticipantFontColor #0B2545
}
hide footbox

title End_Charging(car_id, ChargingPileNum)

actor "用户" as A
boundary "充电控制界面" as UI
control "ChargingRequestController" as C
control "ChargingRequestService" as RS
control "ChargingService" as S
control "PricingService" as PR
control "BillingService" as B
control "DispatchService" as D
entity "ChargingPile" as P
entity "DetailedList" as DL
A -> UI: 结束充电
UI -> C: End_Charging(car_id, ChargingPileNum)
C -> RS: end_charging(payload)
RS -> S: end_charging(request)
S -> S: elapsed/charged 计算
S -> PR: calculate_fee(start, end, charged, power)
PR --> S: 费用
S -> P: activeRequestId=None; record_completion(...)
S -> B: create_detail(...)
create DL
B -> DL: <<create>> DetailedList(...)
B -> B: upsert Bill(按车按日汇总)
S -> D: dispatch_waiting(mode)
S --> RS: Return(1)
RS --> C: Return(1)
C --> UI: Return(0/1)
@enduml
