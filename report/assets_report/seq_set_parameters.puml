@startuml
skinparam dpi 170
skinparam backgroundColor white
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam roundcorner 8
skinparam maxMessageSize 200
skinparam sequence {
  ArrowColor #2E74B5
  ActorBorderColor #0B2545
  LifeLineBorderColor #B8C4D1
  LifeLineBackgroundColor #F7F9FC
  ParticipantBorderColor #2E74B5
  ParticipantBackgroundColor #E8EEF5
  ParticipantFontColor #0B2545
}
hide footbox

title setParameters(计费规则, 三个时段的电价数据等)

actor "管理员" as A
boundary "充电桩管理界面" as UI
control "PileAdminController" as C
control "PileService" as S
entity "ChargingRule" as RULE
database "RuleRepository" as R
A -> UI: 录入峰/平/谷电价与服务费
UI -> C: setParameters(peak, normal, valley, service)
C -> S: set_parameters(payload)
S -> S: 校验非负
S -> R: get()
R --> S: rule
S -> RULE: 修改 peak/normal/valley/service
S -> R: set(rule)
S --> C: Return(1)
C --> UI: Return(0/1)
@enduml
